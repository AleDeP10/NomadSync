# ── Environment ──────────────────────────────────────────
env=dev

# ── Paths ────────────────────────────────────────────────
vaults.file=vaults.json

# ── Git ──────────────────────────────────────────────────
git.executable=C:/Program Files/Git/bin/git.exe
git.remote=origin
git.branch=main

# GitHub credentials
git.name=YOURREALNAME
git.email=YOUREMAIL
git.username=YOURUSERNAME
git.token=ghp_YOURDEVTOKENHERE

# ── Socket ───────────────────────────────────────────────
socket.retryDelay=30000

# ── Autosave ─────────────────────────────────────────────
# Interval in minutes between differential autosave checks
autosave.interval.minutes=15

# ── Logging ──────────────────────────────────────────────
log.path=C:/Users/YOURUSER/IdeaProjects/ObsidianSync/logs/obsidiansync.log
log.level=DEBUG