# ------------------------------------------------------------
# Build Output
# ------------------------------------------------------------
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper exception
!.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------
# jpackage installers (M8+)
# ------------------------------------------------------------
installer/
*.exe
*.pkg
*.dmg

# ------------------------------------------------------------
# Application Runtime Configuration & Secrets
# ------------------------------------------------------------

# Ignore active local configuration files at the project root
/src/main/resources/config.properties
/src/main/resources/config.dev.properties
/src/main/resources/config.prod.properties
/src/main/resources/catalog.json
/src/main/resources/workspaces.json

# Editor backup files of the above
/src/main/resources/*.properties.bak
/src/main/resources/catalog.json.bak
/src/main/resources/workspaces.json.bak

# Explicitly ensure resource templates are ALWAYS tracked in Git
!src/main/resources/config.template.properties
!src/main/resources/catalog.template.json
!src/main/resources/workspaces.template.json

# ------------------------------------------------------------
# Logs & JVM Diagnostics
# ------------------------------------------------------------
*.log
logs/
target/logs/
hs_err_pid*
replay_pid*

