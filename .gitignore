# ══════════════════════════════════════════
# Build Output
# ══════════════════════════════════════════
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper exception
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ══════════════════════════════════════════
# Application Runtime Configuration & Secrets
# ══════════════════════════════════════════
# Ignore active local configuration files at the project root
/src/main/resources/config.properties
/src/main/resources/config.dev.properties
/src/main/resources/config.prod.properties
/src/main/resources/vaults.json

# Explicitly ensure resource templates are ALWAYS tracked in Git
!src/main/resources/config.template.properties
!src/main/resources/vaults.template.json

# ══════════════════════════════════════════
# Logs & JVM Diagnostics
# ══════════════════════════════════════════
*.log
logs/
target/logs/
hs_err_pid*
replay_pid*

# ══════════════════════════════════════════
# IDEs & Editors Configuration
# ══════════════════════════════════════════
# IntelliJ IDEA
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
*.iws
*.iml
*.ipr

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# ══════════════════════════════════════════
# macOS System Junk (Complete Cleanup)
# ══════════════════════════════════════════
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/Icon_
**._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent